{"lang": "it", "levels": [{"id": "A1", "jlpt": "CILS A1", "name": "Beginner", "desc": "Greetings, essere & avere, the café, family, the city, everyday verbs", "units": [{"title": "Ciao!", "icon": "👋", "lessons": [{"id": "it-a1-saluti", "title": "Greetings", "type": "vocab", "items": [{"id": "vocab:ciao", "jp": "ciao", "romaji": "ciao", "en": "hi / bye (informal)"}, {"id": "vocab:buongiorno", "jp": "buongiorno", "romaji": "buongiorno", "en": "good morning / hello"}, {"id": "vocab:buonasera", "jp": "buonasera", "romaji": "buonasera", "en": "good evening"}, {"id": "vocab:buonanotte", "jp": "buonanotte", "romaji": "buonanotte", "en": "good night"}, {"id": "vocab:arrivederci", "jp": "arrivederci", "romaji": "arrivederci", "en": "goodbye"}, {"id": "vocab:grazie", "jp": "grazie", "romaji": "grazie", "en": "thank you"}, {"id": "vocab:prego", "jp": "prego", "romaji": "prego", "en": "you're welcome"}, {"id": "vocab:scusi", "jp": "scusi", "romaji": "scusi", "en": "excuse me (formal)"}, {"id": "vocab:per favore", "jp": "per favore", "romaji": "per favore", "en": "please"}]}, {"id": "it-a1-essere", "title": "I am…", "type": "grammar", "point": "essere: sono, sei, è", "explain": "Essere means \"to be\". io sono (I am), tu sei (you are, informal), lui / lei è (he / she is), Lei è (you are, formal). Like Spanish, Italian usually drops the pronoun: \"Sono Marco\" is enough. Use Lei (capital L) with strangers, shop staff and older people.", "examples": [["Sono Giulia.", "", "I'm Giulia."], ["Sei italiano?", "", "Are you Italian?"], ["Lei è di Roma.", "", "She is from Rome."]], "exercises": [{"fill": "Io ＿ Marco.", "options": ["sono", "sei", "è", "siamo"], "answer": "sono", "en": "I'm Marco."}, {"fill": "Tu ＿ di Milano?", "options": ["sei", "sono", "è", "siete"], "answer": "sei", "en": "Are you from Milan?"}, {"fill": "Lui ＿ medico.", "options": ["è", "sei", "sono", "ha"], "answer": "è", "en": "He is a doctor."}, {"fill": "Scusi, Lei ＿ la signora Rossi?", "options": ["è", "sei", "sono", "siete"], "answer": "è", "en": "Excuse me, are you Mrs Rossi?"}, {"order": ["Io", "sono", "di", "Parigi"], "en": "I'm from Paris."}, {"order": ["Sei", "di", "Napoli?"], "en": "Are you from Naples?"}]}, {"id": "it-a1-essere-pl", "title": "We are, they are", "type": "grammar", "point": "essere: siamo, siete, sono", "explain": "Plural forms: noi siamo (we are), voi siete (you all are), loro sono (they are). Watch out: sono is both \"I am\" and \"they are\". The context (or the pronoun) tells you which.", "examples": [["Siamo amici.", "", "We are friends."], ["Siete studenti?", "", "Are you (all) students?"], ["Loro sono di Firenze.", "", "They are from Florence."]], "exercises": [{"fill": "Noi ＿ in vacanza.", "options": ["siamo", "siete", "sono", "è"], "answer": "siamo", "en": "We are on holiday."}, {"fill": "Voi ＿ fratelli?", "options": ["siete", "siamo", "sei", "sono"], "answer": "siete", "en": "Are you brothers?"}, {"fill": "Paolo e Anna ＿ di Torino.", "options": ["sono", "è", "siamo", "siete"], "answer": "sono", "en": "Paolo and Anna are from Turin."}, {"order": ["Noi", "siamo", "in", "Italia"], "en": "We are in Italy."}, {"order": ["Loro", "sono", "molto", "simpatici"], "en": "They are very nice."}]}, {"id": "it-a1-persone", "title": "People & countries", "type": "vocab", "items": [{"id": "vocab:l'amico", "jp": "l'amico", "romaji": "l'amico", "en": "friend (m)"}, {"id": "vocab:l'amica", "jp": "l'amica", "romaji": "l'amica", "en": "friend (f)"}, {"id": "vocab:il ragazzo", "jp": "il ragazzo", "romaji": "il ragazzo", "en": "boy / boyfriend"}, {"id": "vocab:la ragazza", "jp": "la ragazza", "romaji": "la ragazza", "en": "girl / girlfriend"}, {"id": "vocab:italiano", "jp": "italiano", "romaji": "italiano", "en": "Italian (m)"}, {"id": "vocab:francese", "jp": "francese", "romaji": "francese", "en": "French"}, {"id": "vocab:lo studente", "jp": "lo studente", "romaji": "lo studente", "en": "student (m)"}, {"id": "vocab:la studentessa", "jp": "la studentessa", "romaji": "la studentessa", "en": "student (f)"}]}, {"id": "it-a1-r-giulia", "title": "Reading: Giulia introduces herself", "type": "reading", "tokens": [{"t": "Ciao!", "r": "", "en": "hi!"}, {"t": "Mi", "r": "", "en": "myself"}, {"t": "chiamo", "r": "", "en": "I call"}, {"t": "Giulia.", "r": "", "en": "Giulia"}, {"t": "Sono", "r": "", "en": "I am"}, {"t": "di", "r": "", "en": "from"}, {"t": "Bologna,", "r": "", "en": "Bologna"}, {"t": "ma", "r": "", "en": "but"}, {"t": "abito", "r": "", "en": "I live"}, {"t": "a", "r": "", "en": "in"}, {"t": "Roma.", "r": "", "en": "Rome"}, {"t": "Sono", "r": "", "en": "I am"}, {"t": "studentessa", "r": "", "en": "student"}, {"t": "di", "r": "", "en": "of"}, {"t": "architettura.", "r": "", "en": "architecture"}, {"t": "Il", "r": "", "en": "the"}, {"t": "mio", "r": "", "en": "my"}, {"t": "amico", "r": "", "en": "friend"}, {"t": "Luca", "r": "", "en": "Luca"}, {"t": "è", "r": "", "en": "is"}, {"t": "francese.", "r": "", "en": "French"}], "translation": "Hi! My name is Giulia. I'm from Bologna, but I live in Rome. I'm an architecture student. My friend Luca is French.", "questions": [{"q": "Where is Giulia from?", "options": ["Bologna", "Rome", "Milan", "Paris"], "answer": "Bologna"}, {"q": "Where does she live?", "options": ["Rome", "Bologna", "Florence", "Naples"], "answer": "Rome"}, {"q": "What nationality is Luca?", "options": ["French", "Italian", "Spanish", "English"], "answer": "French"}]}], "color": "#ff7aa2"}, {"title": "Numbers & Time", "icon": "🕐", "lessons": [{"id": "it-a1-num1", "title": "Numbers 1–10", "type": "vocab", "items": [{"id": "vocab:uno", "jp": "uno", "romaji": "uno", "en": "one"}, {"id": "vocab:due", "jp": "due", "romaji": "due", "en": "two"}, {"id": "vocab:tre", "jp": "tre", "romaji": "tre", "en": "three"}, {"id": "vocab:quattro", "jp": "quattro", "romaji": "quattro", "en": "four"}, {"id": "vocab:cinque", "jp": "cinque", "romaji": "cinque", "en": "five"}, {"id": "vocab:sei", "jp": "sei", "romaji": "sei", "en": "six"}, {"id": "vocab:sette", "jp": "sette", "romaji": "sette", "en": "seven"}, {"id": "vocab:otto", "jp": "otto", "romaji": "otto", "en": "eight"}, {"id": "vocab:nove", "jp": "nove", "romaji": "nove", "en": "nine"}, {"id": "vocab:dieci", "jp": "dieci", "romaji": "dieci", "en": "ten"}]}, {"id": "it-a1-num2", "title": "Numbers 11–20", "type": "vocab", "items": [{"id": "vocab:undici", "jp": "undici", "romaji": "undici", "en": "eleven"}, {"id": "vocab:dodici", "jp": "dodici", "romaji": "dodici", "en": "twelve"}, {"id": "vocab:tredici", "jp": "tredici", "romaji": "tredici", "en": "thirteen"}, {"id": "vocab:quattordici", "jp": "quattordici", "romaji": "quattordici", "en": "fourteen"}, {"id": "vocab:quindici", "jp": "quindici", "romaji": "quindici", "en": "fifteen"}, {"id": "vocab:sedici", "jp": "sedici", "romaji": "sedici", "en": "sixteen"}, {"id": "vocab:diciassette", "jp": "diciassette", "romaji": "diciassette", "en": "seventeen"}, {"id": "vocab:diciotto", "jp": "diciotto", "romaji": "diciotto", "en": "eighteen"}, {"id": "vocab:diciannove", "jp": "diciannove", "romaji": "diciannove", "en": "nineteen"}, {"id": "vocab:venti", "jp": "venti", "romaji": "venti", "en": "twenty"}]}, {"id": "it-a1-ore", "title": "What time is it?", "type": "grammar", "point": "Che ore sono? / Sono le… / È l'una", "explain": "To give the time, use sono le + number: \"Sono le tre\" (it's three o'clock). One o'clock is singular: \"È l'una\". Noon and midnight: \"È mezzogiorno\", \"È mezzanotte\". Add e mezza (half past) or e un quarto (quarter past).", "examples": [["Che ore sono?", "", "What time is it?"], ["Sono le otto e mezza.", "", "It's half past eight."], ["È l'una.", "", "It's one o'clock."]], "exercises": [{"fill": "＿ le quattro.", "options": ["Sono", "È", "Ha", "Sei"], "answer": "Sono", "en": "It's four o'clock."}, {"fill": "È ＿ una.", "options": ["l'", "le", "la", "il"], "answer": "l'", "en": "It's one o'clock."}, {"fill": "Sono le sette e ＿.", "options": ["mezza", "metà", "mezzo", "quarto"], "answer": "mezza", "en": "It's half past seven."}, {"order": ["Che", "ore", "sono?"], "en": "What time is it?"}, {"order": ["Sono", "le", "dieci", "e", "un", "quarto"], "en": "It's quarter past ten."}]}, {"id": "it-a1-giorni", "title": "Days of the week", "type": "vocab", "items": [{"id": "vocab:lunedì", "jp": "lunedì", "romaji": "lunedì", "en": "Monday"}, {"id": "vocab:martedì", "jp": "martedì", "romaji": "martedì", "en": "Tuesday"}, {"id": "vocab:mercoledì", "jp": "mercoledì", "romaji": "mercoledì", "en": "Wednesday"}, {"id": "vocab:giovedì", "jp": "giovedì", "romaji": "giovedì", "en": "Thursday"}, {"id": "vocab:venerdì", "jp": "venerdì", "romaji": "venerdì", "en": "Friday"}, {"id": "vocab:sabato", "jp": "sabato", "romaji": "sabato", "en": "Saturday"}, {"id": "vocab:domenica", "jp": "domenica", "romaji": "domenica", "en": "Sunday"}, {"id": "vocab:oggi", "jp": "oggi", "romaji": "oggi", "en": "today"}, {"id": "vocab:domani", "jp": "domani", "romaji": "domani", "en": "tomorrow"}]}], "color": "#7a9cff"}, {"title": "Al bar", "icon": "☕", "lessons": [{"id": "it-a1-bar", "title": "At the café", "type": "vocab", "items": [{"id": "vocab:il caffè", "jp": "il caffè", "romaji": "il caffè", "en": "espresso / coffee"}, {"id": "vocab:il cappuccino", "jp": "il cappuccino", "romaji": "il cappuccino", "en": "cappuccino"}, {"id": "vocab:il cornetto", "jp": "il cornetto", "romaji": "il cornetto", "en": "croissant"}, {"id": "vocab:l'acqua", "jp": "l'acqua", "romaji": "l'acqua", "en": "water"}, {"id": "vocab:il succo", "jp": "il succo", "romaji": "il succo", "en": "juice"}, {"id": "vocab:il tramezzino", "jp": "il tramezzino", "romaji": "il tramezzino", "en": "sandwich"}, {"id": "vocab:il conto", "jp": "il conto", "romaji": "il conto", "en": "the bill"}, {"id": "vocab:lo scontrino", "jp": "lo scontrino", "romaji": "lo scontrino", "en": "the receipt"}]}, {"id": "it-a1-articoli", "title": "The: il, lo, la, l'", "type": "grammar", "point": "il / lo / la / l' (singular articles)", "explain": "Masculine nouns take il (il caffè), but lo before s + consonant, z, gn, ps (lo zucchero, lo studente). Feminine nouns take la (la pizza). Before a vowel both become l' (l'amico, l'acqua).", "examples": [["il cappuccino", "", "the cappuccino"], ["lo zucchero", "", "the sugar"], ["la brioche", "", "the brioche"], ["l'aranciata", "", "the orange soda"]], "exercises": [{"fill": "＿ caffè è buono.", "options": ["Il", "Lo", "La", "L'"], "answer": "Il", "en": "The coffee is good."}, {"fill": "Dov'è ＿ zucchero?", "options": ["lo", "il", "la", "l'"], "answer": "lo", "en": "Where is the sugar?"}, {"fill": "＿ acqua è fredda.", "options": ["L'", "La", "Il", "Lo"], "answer": "L'", "en": "The water is cold."}, {"fill": "＿ pizza è calda.", "options": ["La", "Il", "Lo", "L'"], "answer": "La", "en": "The pizza is hot."}, {"order": ["Il", "conto,", "per", "favore"], "en": "The bill, please."}]}, {"id": "it-a1-vorrei", "title": "I'd like…", "type": "grammar", "point": "vorrei + noun / verb", "explain": "Vorrei (I would like) is the polite way to order: \"Vorrei un caffè\". \"Prendo…\" (I'll have…) is also very common at the bar. Add per favore for politeness.", "examples": [["Vorrei un cappuccino, per favore.", "", "I'd like a cappuccino, please."], ["Prendo un cornetto.", "", "I'll have a croissant."], ["Vorrei pagare.", "", "I'd like to pay."]], "exercises": [{"fill": "＿ un caffè, per favore.", "options": ["Vorrei", "Sono", "Ho", "Siamo"], "answer": "Vorrei", "en": "I'd like a coffee, please."}, {"fill": "＿ un succo d'arancia.", "options": ["Prendo", "Prende", "Prendi", "Prendono"], "answer": "Prendo", "en": "I'll have an orange juice."}, {"fill": "Vorrei ＿ il conto.", "options": ["pagare", "pago", "paghi", "pagato"], "answer": "pagare", "en": "I'd like to pay the bill."}, {"order": ["Vorrei", "un", "cornetto,", "per", "favore"], "en": "I'd like a croissant, please."}, {"order": ["Prendo", "un", "caffè", "al", "banco"], "en": "I'll have a coffee at the counter."}]}, {"id": "it-a1-r-bar", "title": "Reading: a morning at the bar", "type": "reading", "tokens": [{"t": "Ogni", "r": "", "en": "every"}, {"t": "mattina", "r": "", "en": "morning"}, {"t": "Marco", "r": "", "en": "Marco"}, {"t": "va", "r": "", "en": "goes"}, {"t": "al", "r": "", "en": "to the"}, {"t": "bar.", "r": "", "en": "café"}, {"t": "Prende", "r": "", "en": "he has"}, {"t": "un", "r": "", "en": "a"}, {"t": "caffè", "r": "", "en": "espresso"}, {"t": "al", "r": "", "en": "at the"}, {"t": "banco", "r": "", "en": "counter"}, {"t": "e", "r": "", "en": "and"}, {"t": "un", "r": "", "en": "a"}, {"t": "cornetto", "r": "", "en": "croissant"}, {"t": "alla", "r": "", "en": "with"}, {"t": "crema.", "r": "", "en": "custard"}, {"t": "Paga", "r": "", "en": "he pays"}, {"t": "due", "r": "", "en": "two"}, {"t": "euro", "r": "", "en": "euros"}, {"t": "e", "r": "", "en": "and"}, {"t": "va", "r": "", "en": "goes"}, {"t": "al", "r": "", "en": "to"}, {"t": "lavoro.", "r": "", "en": "work"}], "translation": "Every morning Marco goes to the café. He has an espresso at the counter and a custard croissant. He pays two euros and goes to work.", "questions": [{"q": "Where does Marco drink his coffee?", "options": ["At the counter", "At home", "At work", "On the terrace"], "answer": "At the counter"}, {"q": "What does he eat?", "options": ["A custard croissant", "A sandwich", "A pizza", "Nothing"], "answer": "A custard croissant"}, {"q": "How much does he pay?", "options": ["Two euros", "Five euros", "One euro", "Ten euros"], "answer": "Two euros"}]}], "color": "#4fc3a1"}, {"title": "Family & Home", "icon": "🏡", "lessons": [{"id": "it-a1-famiglia", "title": "Family", "type": "vocab", "items": [{"id": "vocab:la madre", "jp": "la madre", "romaji": "la madre", "en": "mother"}, {"id": "vocab:il padre", "jp": "il padre", "romaji": "il padre", "en": "father"}, {"id": "vocab:il fratello", "jp": "il fratello", "romaji": "il fratello", "en": "brother"}, {"id": "vocab:la sorella", "jp": "la sorella", "romaji": "la sorella", "en": "sister"}, {"id": "vocab:il figlio", "jp": "il figlio", "romaji": "il figlio", "en": "son"}, {"id": "vocab:la figlia", "jp": "la figlia", "romaji": "la figlia", "en": "daughter"}, {"id": "vocab:i nonni", "jp": "i nonni", "romaji": "i nonni", "en": "grandparents"}, {"id": "vocab:la famiglia", "jp": "la famiglia", "romaji": "la famiglia", "en": "family"}]}, {"id": "it-a1-avere", "title": "I have…", "type": "grammar", "point": "avere: ho, hai, ha, abbiamo, avete, hanno", "explain": "Avere means \"to have\". The h is silent: ho sounds like \"o\". Italian also uses avere for age: \"Ho vent'anni\" (I'm twenty, literally \"I have twenty years\"), and for hunger and thirst: \"Ho fame\", \"Ho sete\".", "examples": [["Ho due fratelli.", "", "I have two brothers."], ["Quanti anni hai?", "", "How old are you?"], ["Abbiamo fame.", "", "We're hungry."]], "exercises": [{"fill": "Io ＿ una sorella.", "options": ["ho", "hai", "ha", "hanno"], "answer": "ho", "en": "I have a sister."}, {"fill": "Quanti anni ＿ tu?", "options": ["hai", "ho", "ha", "avete"], "answer": "hai", "en": "How old are you?"}, {"fill": "Loro ＿ una casa al mare.", "options": ["hanno", "ha", "abbiamo", "avete"], "answer": "hanno", "en": "They have a house by the sea."}, {"fill": "Noi ＿ sete.", "options": ["abbiamo", "avete", "hanno", "siamo"], "answer": "abbiamo", "en": "We're thirsty."}, {"order": ["Ho", "trent'anni"], "en": "I'm thirty."}, {"order": ["Mia", "sorella", "ha", "due", "figli"], "en": "My sister has two children."}]}, {"id": "it-a1-casa", "title": "At home", "type": "vocab", "items": [{"id": "vocab:la casa", "jp": "la casa", "romaji": "la casa", "en": "house / home"}, {"id": "vocab:l'appartamento", "jp": "l'appartamento", "romaji": "l'appartamento", "en": "flat"}, {"id": "vocab:la cucina", "jp": "la cucina", "romaji": "la cucina", "en": "kitchen"}, {"id": "vocab:la camera", "jp": "la camera", "romaji": "la camera", "en": "bedroom"}, {"id": "vocab:il bagno", "jp": "il bagno", "romaji": "il bagno", "en": "bathroom"}, {"id": "vocab:il soggiorno", "jp": "il soggiorno", "romaji": "il soggiorno", "en": "living room"}, {"id": "vocab:il letto", "jp": "il letto", "romaji": "il letto", "en": "bed"}, {"id": "vocab:la finestra", "jp": "la finestra", "romaji": "la finestra", "en": "window"}]}], "color": "#f2a541"}, {"title": "In città", "icon": "🏛️", "lessons": [{"id": "it-a1-citta", "title": "Places in town", "type": "vocab", "items": [{"id": "vocab:la piazza", "jp": "la piazza", "romaji": "la piazza", "en": "square"}, {"id": "vocab:la stazione", "jp": "la stazione", "romaji": "la stazione", "en": "station"}, {"id": "vocab:la chiesa", "jp": "la chiesa", "romaji": "la chiesa", "en": "church"}, {"id": "vocab:il museo", "jp": "il museo", "romaji": "il museo", "en": "museum"}, {"id": "vocab:la farmacia", "jp": "la farmacia", "romaji": "la farmacia", "en": "pharmacy"}, {"id": "vocab:il supermercato", "jp": "il supermercato", "romaji": "il supermercato", "en": "supermarket"}, {"id": "vocab:la banca", "jp": "la banca", "romaji": "la banca", "en": "bank"}, {"id": "vocab:il ristorante", "jp": "il ristorante", "romaji": "il ristorante", "en": "restaurant"}]}, {"id": "it-a1-ce", "title": "There is / there are", "type": "grammar", "point": "c'è / ci sono", "explain": "C'è (there is) + singular, ci sono (there are) + plural. Questions use the same words with a rising tone: \"C'è una farmacia qui vicino?\" (Is there a pharmacy nearby?).", "examples": [["C'è un bar in piazza.", "", "There's a café in the square."], ["Ci sono due musei.", "", "There are two museums."], ["C'è una banca qui vicino?", "", "Is there a bank nearby?"]], "exercises": [{"fill": "＿ una stazione qui vicino?", "options": ["C'è", "Ci sono", "È", "Sono"], "answer": "C'è", "en": "Is there a station nearby?"}, {"fill": "In piazza ＿ tre ristoranti.", "options": ["ci sono", "c'è", "sono", "è"], "answer": "ci sono", "en": "There are three restaurants in the square."}, {"fill": "Non ＿ un supermercato.", "options": ["c'è", "ci sono", "è", "ha"], "answer": "c'è", "en": "There isn't a supermarket."}, {"order": ["C'è", "una", "farmacia", "qui", "vicino?"], "en": "Is there a pharmacy nearby?"}]}, {"id": "it-a1-direzioni", "title": "Directions", "type": "vocab", "items": [{"id": "vocab:a destra", "jp": "a destra", "romaji": "a destra", "en": "to the right"}, {"id": "vocab:a sinistra", "jp": "a sinistra", "romaji": "a sinistra", "en": "to the left"}, {"id": "vocab:dritto", "jp": "dritto", "romaji": "dritto", "en": "straight on"}, {"id": "vocab:vicino", "jp": "vicino", "romaji": "vicino", "en": "near"}, {"id": "vocab:lontano", "jp": "lontano", "romaji": "lontano", "en": "far"}, {"id": "vocab:davanti a", "jp": "davanti a", "romaji": "davanti a", "en": "in front of"}, {"id": "vocab:dietro", "jp": "dietro", "romaji": "dietro", "en": "behind"}, {"id": "vocab:dov'è…?", "jp": "dov'è…?", "romaji": "dov'è…?", "en": "where is…?"}]}, {"id": "it-a1-r-roma", "title": "Reading: a walk in Rome", "type": "reading", "tokens": [{"t": "Sono", "r": "", "en": "I am"}, {"t": "in", "r": "", "en": "in"}, {"t": "piazza", "r": "", "en": "square"}, {"t": "Navona.", "r": "", "en": "Navona"}, {"t": "C'è", "r": "", "en": "there is"}, {"t": "molta", "r": "", "en": "a lot of"}, {"t": "gente.", "r": "", "en": "people"}, {"t": "Il", "r": "", "en": "the"}, {"t": "Pantheon", "r": "", "en": "Pantheon"}, {"t": "è", "r": "", "en": "is"}, {"t": "vicino,", "r": "", "en": "near"}, {"t": "a", "r": "", "en": "on the"}, {"t": "destra.", "r": "", "en": "right"}, {"t": "La", "r": "", "en": "the"}, {"t": "stazione", "r": "", "en": "station"}, {"t": "Termini", "r": "", "en": "Termini"}, {"t": "invece", "r": "", "en": "on the other hand"}, {"t": "è", "r": "", "en": "is"}, {"t": "lontano:", "r": "", "en": "far"}, {"t": "prendo", "r": "", "en": "I take"}, {"t": "l'autobus.", "r": "", "en": "the bus"}], "translation": "I'm in Piazza Navona. There are a lot of people. The Pantheon is near, on the right. Termini station, on the other hand, is far: I take the bus.", "questions": [{"q": "Where is the narrator?", "options": ["Piazza Navona", "Termini station", "The Pantheon", "At home"], "answer": "Piazza Navona"}, {"q": "Where is the Pantheon?", "options": ["Near, on the right", "Far away", "On the left", "Behind the station"], "answer": "Near, on the right"}, {"q": "How does the narrator get to the station?", "options": ["By bus", "On foot", "By taxi", "By train"], "answer": "By bus"}]}], "color": "#b07aff"}, {"title": "La giornata", "icon": "☀️", "lessons": [{"id": "it-a1-verbi", "title": "Everyday verbs", "type": "vocab", "items": [{"id": "vocab:parlare", "jp": "parlare", "romaji": "parlare", "en": "to speak"}, {"id": "vocab:mangiare", "jp": "mangiare", "romaji": "mangiare", "en": "to eat"}, {"id": "vocab:lavorare", "jp": "lavorare", "romaji": "lavorare", "en": "to work"}, {"id": "vocab:abitare", "jp": "abitare", "romaji": "abitare", "en": "to live"}, {"id": "vocab:leggere", "jp": "leggere", "romaji": "leggere", "en": "to read"}, {"id": "vocab:scrivere", "jp": "scrivere", "romaji": "scrivere", "en": "to write"}, {"id": "vocab:dormire", "jp": "dormire", "romaji": "dormire", "en": "to sleep"}, {"id": "vocab:partire", "jp": "partire", "romaji": "partire", "en": "to leave"}]}, {"id": "it-a1-are", "title": "Regular -are verbs", "type": "grammar", "point": "presente: parlo, parli, parla, parliamo, parlate, parlano", "explain": "Most Italian verbs end in -are. Drop -are and add: -o, -i, -a, -iamo, -ate, -ano. Parlo italiano (I speak Italian), lavoriamo a Milano (we work in Milan). Stress stays on the stem in parlano: PAR-la-no.", "examples": [["Parlo un po' d'italiano.", "", "I speak a little Italian."], ["Dove lavori?", "", "Where do you work?"], ["Abitano a Venezia.", "", "They live in Venice."]], "exercises": [{"fill": "Io ＿ francese e italiano.", "options": ["parlo", "parli", "parla", "parlano"], "answer": "parlo", "en": "I speak French and Italian."}, {"fill": "Tu dove ＿?", "options": ["abiti", "abito", "abita", "abitiamo"], "answer": "abiti", "en": "Where do you live?"}, {"fill": "Noi ＿ la pizza stasera.", "options": ["mangiamo", "mangiate", "mangiano", "mangio"], "answer": "mangiamo", "en": "We're eating pizza tonight."}, {"fill": "Loro ＿ in banca.", "options": ["lavorano", "lavora", "lavorate", "lavoro"], "answer": "lavorano", "en": "They work in a bank."}, {"order": ["Parlo", "un", "po'", "d'italiano"], "en": "I speak a little Italian."}]}, {"id": "it-a1-ere-ire", "title": "-ere and -ire verbs", "type": "grammar", "point": "leggo, leggi, legge… / dormo, dormi, dorme…", "explain": "Verbs in -ere and -ire share almost the same endings: -o, -i, -e, -iamo, -ete / -ite, -ono. Leggo un libro (I read a book), dormiamo poco (we sleep little), partono domani (they leave tomorrow).", "examples": [["Leggo il giornale.", "", "I read the newspaper."], ["Dormi bene?", "", "Do you sleep well?"], ["Il treno parte alle nove.", "", "The train leaves at nine."]], "exercises": [{"fill": "Lei ＿ un libro.", "options": ["legge", "leggo", "leggi", "leggono"], "answer": "legge", "en": "She is reading a book."}, {"fill": "Voi ＿ troppo poco.", "options": ["dormite", "dormiamo", "dormono", "dorme"], "answer": "dormite", "en": "You (all) sleep too little."}, {"fill": "Il treno ＿ alle otto.", "options": ["parte", "parto", "parti", "partono"], "answer": "parte", "en": "The train leaves at eight."}, {"order": ["Scrivo", "una", "lettera", "a", "mia", "madre"], "en": "I'm writing a letter to my mother."}]}], "color": "#3cb8d8"}], "ai": false}, {"id": "A2", "jlpt": "CILS A2", "name": "Elementary", "desc": "The past, food & markets, likes, travel, the future", "units": [{"title": "Il weekend scorso", "icon": "📸", "lessons": [{"id": "it-a2-pp-avere", "title": "What did you do?", "type": "grammar", "point": "passato prossimo con avere: ho mangiato", "explain": "The passato prossimo is the everyday past tense: avere + past participle. -are → -ato (mangiato), -ere → -uto (venduto), -ire → -ito (dormito). Common irregulars: fatto (done), visto (seen), preso (taken), letto (read).", "examples": [["Ho mangiato una pizza.", "", "I ate a pizza."], ["Hai visto il film?", "", "Did you see the film?"], ["Abbiamo fatto una passeggiata.", "", "We went for a walk."]], "exercises": [{"fill": "Ieri ＿ lavorato molto.", "options": ["ho", "sono", "hai", "è"], "answer": "ho", "en": "Yesterday I worked a lot."}, {"fill": "Hai ＿ il libro?", "options": ["letto", "leggere", "leggi", "legge"], "answer": "letto", "en": "Have you read the book?"}, {"fill": "Che cosa avete ＿ sabato?", "options": ["fatto", "fare", "fate", "faccio"], "answer": "fatto", "en": "What did you do on Saturday?"}, {"order": ["Ho", "visto", "un", "bel", "film"], "en": "I saw a good film."}, {"order": ["Abbiamo", "mangiato", "al", "ristorante"], "en": "We ate at the restaurant."}]}, {"id": "it-a2-pp-essere", "title": "Where did you go?", "type": "grammar", "point": "passato prossimo con essere: sono andato / andata", "explain": "Verbs of movement and change (andare, venire, partire, arrivare, uscire, restare…) use essere. The participle agrees like an adjective: sono andato (m), sono andata (f), siamo andati (m pl), siamo andate (f pl).", "examples": [["Sono andata a Napoli.", "", "I (f) went to Naples."], ["Siete usciti ieri sera?", "", "Did you (pl) go out last night?"], ["Marco è arrivato tardi.", "", "Marco arrived late."]], "exercises": [{"fill": "Anna ＿ partita lunedì.", "options": ["è", "ha", "sono", "hai"], "answer": "è", "en": "Anna left on Monday."}, {"fill": "Noi siamo ＿ al mare.", "options": ["andati", "andato", "andata", "andare"], "answer": "andati", "en": "We went to the seaside."}, {"fill": "Luca è ＿ a casa.", "options": ["restato", "restata", "restati", "restare"], "answer": "restato", "en": "Luca stayed at home."}, {"order": ["Sono", "andato", "a", "Firenze", "in", "treno"], "en": "I went to Florence by train."}]}, {"id": "it-a2-tempo", "title": "Time expressions", "type": "vocab", "items": [{"id": "vocab:ieri", "jp": "ieri", "romaji": "ieri", "en": "yesterday"}, {"id": "vocab:ieri sera", "jp": "ieri sera", "romaji": "ieri sera", "en": "last night"}, {"id": "vocab:la settimana scorsa", "jp": "la settimana scorsa", "romaji": "la settimana scorsa", "en": "last week"}, {"id": "vocab:l'anno scorso", "jp": "l'anno scorso", "romaji": "l'anno scorso", "en": "last year"}, {"id": "vocab:fa", "jp": "fa", "romaji": "fa", "en": "ago"}, {"id": "vocab:già", "jp": "già", "romaji": "già", "en": "already"}, {"id": "vocab:non… ancora", "jp": "non… ancora", "romaji": "non… ancora", "en": "not… yet"}, {"id": "vocab:poi", "jp": "poi", "romaji": "poi", "en": "then"}]}, {"id": "it-a2-r-weekend", "title": "Reading: a weekend in Florence", "type": "reading", "tokens": [{"t": "Sabato", "r": "", "en": "on Saturday"}, {"t": "sono", "r": "", "en": "I"}, {"t": "andata", "r": "", "en": "went"}, {"t": "a", "r": "", "en": "to"}, {"t": "Firenze", "r": "", "en": "Florence"}, {"t": "con", "r": "", "en": "with"}, {"t": "mia", "r": "", "en": "my"}, {"t": "sorella.", "r": "", "en": "sister"}, {"t": "Abbiamo", "r": "", "en": "we"}, {"t": "visitato", "r": "", "en": "visited"}, {"t": "gli", "r": "", "en": "the"}, {"t": "Uffizi", "r": "", "en": "Uffizi"}, {"t": "e", "r": "", "en": "and"}, {"t": "abbiamo", "r": "", "en": "we"}, {"t": "mangiato", "r": "", "en": "ate"}, {"t": "una", "r": "", "en": "a"}, {"t": "bistecca", "r": "", "en": "steak"}, {"t": "enorme.", "r": "", "en": "huge"}, {"t": "Domenica", "r": "", "en": "on Sunday"}, {"t": "siamo", "r": "", "en": "we"}, {"t": "tornate", "r": "", "en": "came back"}, {"t": "a", "r": "", "en": "to"}, {"t": "casa", "r": "", "en": "home"}, {"t": "stanche", "r": "", "en": "tired"}, {"t": "ma", "r": "", "en": "but"}, {"t": "felici.", "r": "", "en": "happy"}], "translation": "On Saturday I went to Florence with my sister. We visited the Uffizi and we ate a huge steak. On Sunday we came back home tired but happy.", "questions": [{"q": "Who did the narrator travel with?", "options": ["Her sister", "Her brother", "Her mother", "Alone"], "answer": "Her sister"}, {"q": "What did they visit?", "options": ["The Uffizi", "The Colosseum", "A beach", "A market"], "answer": "The Uffizi"}, {"q": "How did they feel on Sunday?", "options": ["Tired but happy", "Sad", "Bored", "Ill"], "answer": "Tired but happy"}]}], "color": "#ff7aa2"}, {"title": "Al mercato", "icon": "🍅", "lessons": [{"id": "it-a2-cibo", "title": "Food", "type": "vocab", "items": [{"id": "vocab:il pane", "jp": "il pane", "romaji": "il pane", "en": "bread"}, {"id": "vocab:il formaggio", "jp": "il formaggio", "romaji": "il formaggio", "en": "cheese"}, {"id": "vocab:i pomodori", "jp": "i pomodori", "romaji": "i pomodori", "en": "tomatoes"}, {"id": "vocab:la frutta", "jp": "la frutta", "romaji": "la frutta", "en": "fruit"}, {"id": "vocab:la verdura", "jp": "la verdura", "romaji": "la verdura", "en": "vegetables"}, {"id": "vocab:il prosciutto", "jp": "il prosciutto", "romaji": "il prosciutto", "en": "ham"}, {"id": "vocab:l'olio", "jp": "l'olio", "romaji": "l'olio", "en": "oil"}, {"id": "vocab:un etto", "jp": "un etto", "romaji": "un etto", "en": "100 grams"}]}, {"id": "it-a2-piacere", "title": "I like…", "type": "grammar", "point": "mi piace / mi piacciono", "explain": "Piacere works \"backwards\": the thing you like is the subject. Mi piace + singular or a verb (mi piace la pizza, mi piace cucinare), mi piacciono + plural (mi piacciono i pomodori). Ti piace? = Do you like it?", "examples": [["Mi piace il gelato.", "", "I like ice cream."], ["Ti piacciono i film italiani?", "", "Do you like Italian films?"], ["Non mi piace cucinare.", "", "I don't like cooking."]], "exercises": [{"fill": "Mi ＿ la pasta.", "options": ["piace", "piacciono", "piaccio", "piaci"], "answer": "piace", "en": "I like pasta."}, {"fill": "Ti ＿ le olive?", "options": ["piacciono", "piace", "piaci", "piacete"], "answer": "piacciono", "en": "Do you like olives?"}, {"fill": "A Marco ＿ viaggiare.", "options": ["piace", "piacciono", "piaccio", "piacete"], "answer": "piace", "en": "Marco likes travelling."}, {"order": ["Mi", "piacciono", "molto", "i", "mercati"], "en": "I really like markets."}]}, {"id": "it-a2-partitivo", "title": "Some…", "type": "grammar", "point": "del, dello, della, dei, degli, delle", "explain": "To say \"some\", combine di with the article: del pane (some bread), della frutta (some fruit), dei pomodori (some tomatoes), degli spinaci, delle mele. At the market you will also hear un etto di (100 g of) and un chilo di (a kilo of).", "examples": [["Vorrei del pane.", "", "I'd like some bread."], ["Compro dei pomodori.", "", "I'm buying some tomatoes."], ["Un etto di prosciutto, per favore.", "", "100 g of ham, please."]], "exercises": [{"fill": "Vorrei ＿ formaggio.", "options": ["del", "della", "dei", "delle"], "answer": "del", "en": "I'd like some cheese."}, {"fill": "Compriamo ＿ frutta.", "options": ["della", "del", "dei", "degli"], "answer": "della", "en": "We're buying some fruit."}, {"fill": "Ci sono ＿ mele?", "options": ["delle", "dei", "della", "del"], "answer": "delle", "en": "Are there any apples?"}, {"order": ["Un", "chilo", "di", "pomodori,", "per", "favore"], "en": "A kilo of tomatoes, please."}]}, {"id": "it-a2-r-mercato", "title": "Reading: at the market", "type": "reading", "tokens": [{"t": "Buongiorno!", "r": "", "en": "good morning!"}, {"t": "Vorrei", "r": "", "en": "I'd like"}, {"t": "due", "r": "", "en": "two"}, {"t": "etti", "r": "", "en": "hundred grams"}, {"t": "di", "r": "", "en": "of"}, {"t": "prosciutto", "r": "", "en": "ham"}, {"t": "e", "r": "", "en": "and"}, {"t": "un", "r": "", "en": "a"}, {"t": "po'", "r": "", "en": "little"}, {"t": "di", "r": "", "en": "of"}, {"t": "parmigiano.", "r": "", "en": "parmesan"}, {"t": "Le", "r": "", "en": "the"}, {"t": "pesche", "r": "", "en": "peaches"}, {"t": "sono", "r": "", "en": "are"}, {"t": "dolci?", "r": "", "en": "sweet?"}, {"t": "Sì,", "r": "", "en": "yes"}, {"t": "signora,", "r": "", "en": "madam"}, {"t": "sono", "r": "", "en": "they are"}, {"t": "buonissime.", "r": "", "en": "delicious"}, {"t": "Allora", "r": "", "en": "then"}, {"t": "ne", "r": "", "en": "of them"}, {"t": "prendo", "r": "", "en": "I'll take"}, {"t": "un", "r": "", "en": "a"}, {"t": "chilo.", "r": "", "en": "kilo"}], "translation": "Good morning! I'd like two hundred grams of ham and a little parmesan. Are the peaches sweet? Yes, madam, they're delicious. Then I'll take a kilo.", "questions": [{"q": "How much ham does the customer want?", "options": ["200 g", "100 g", "1 kg", "500 g"], "answer": "200 g"}, {"q": "What does she ask about the peaches?", "options": ["If they are sweet", "The price", "Where they come from", "If they are ripe"], "answer": "If they are sweet"}, {"q": "How many peaches does she buy?", "options": ["A kilo", "Two", "None", "Half a kilo"], "answer": "A kilo"}]}], "color": "#7a9cff"}, {"title": "In viaggio", "icon": "🚆", "lessons": [{"id": "it-a2-viaggio", "title": "Travel", "type": "vocab", "items": [{"id": "vocab:il biglietto", "jp": "il biglietto", "romaji": "il biglietto", "en": "ticket"}, {"id": "vocab:il treno", "jp": "il treno", "romaji": "il treno", "en": "train"}, {"id": "vocab:il binario", "jp": "il binario", "romaji": "il binario", "en": "platform"}, {"id": "vocab:l'aereo", "jp": "l'aereo", "romaji": "l'aereo", "en": "plane"}, {"id": "vocab:la valigia", "jp": "la valigia", "romaji": "la valigia", "en": "suitcase"}, {"id": "vocab:l'albergo", "jp": "l'albergo", "romaji": "l'albergo", "en": "hotel"}, {"id": "vocab:la prenotazione", "jp": "la prenotazione", "romaji": "la prenotazione", "en": "booking"}, {"id": "vocab:in ritardo", "jp": "in ritardo", "romaji": "in ritardo", "en": "late"}]}, {"id": "it-a2-futuro", "title": "The future", "type": "grammar", "point": "futuro semplice: partirò, andrai, sarà…", "explain": "Future endings: -ò, -ai, -à, -emo, -ete, -anno, added to the infinitive (-are becomes -er-): parlerò, partirai, prenderà. Irregular stems: sarò (essere), avrò (avere), andrò (andare), farò (fare). Italians often use the present for near plans too.", "examples": [["Domani partirò presto.", "", "Tomorrow I'll leave early."], ["Dove andrai in vacanza?", "", "Where will you go on holiday?"], ["Sarà bellissimo.", "", "It will be wonderful."]], "exercises": [{"fill": "L'anno prossimo ＿ in Sicilia.", "options": ["andrò", "vado", "andato", "andare"], "answer": "andrò", "en": "Next year I'll go to Sicily."}, {"fill": "Il treno ＿ in ritardo.", "options": ["sarà", "sarò", "sarai", "saranno"], "answer": "sarà", "en": "The train will be late."}, {"fill": "Che cosa ＿ stasera?", "options": ["farai", "farò", "fa", "fatto"], "answer": "farai", "en": "What will you do tonight?"}, {"order": ["Domani", "prenderemo", "il", "treno", "delle", "otto"], "en": "Tomorrow we'll take the eight o'clock train."}]}, {"id": "it-a2-riflessivi", "title": "Reflexive verbs", "type": "grammar", "point": "mi alzo, ti svegli, si lava…", "explain": "Reflexive verbs carry a pronoun: mi, ti, si, ci, vi, si. Mi alzo alle sette (I get up at seven), ci vediamo domani (see you tomorrow). In the passato prossimo they take essere: mi sono svegliata tardi.", "examples": [["Mi sveglio alle sette.", "", "I wake up at seven."], ["Come ti chiami?", "", "What's your name?"], ["Ci vediamo stasera!", "", "See you tonight!"]], "exercises": [{"fill": "Io ＿ alzo presto.", "options": ["mi", "ti", "si", "ci"], "answer": "mi", "en": "I get up early."}, {"fill": "Come ＿ chiami?", "options": ["ti", "mi", "si", "vi"], "answer": "ti", "en": "What's your name?"}, {"fill": "Ieri mi ＿ svegliato tardi.", "options": ["sono", "ho", "è", "sei"], "answer": "sono", "en": "Yesterday I woke up late."}, {"order": ["Ci", "vediamo", "domani", "in", "stazione"], "en": "See you tomorrow at the station."}]}, {"id": "it-a2-r-treno", "title": "Reading: at the station", "type": "reading", "tokens": [{"t": "Il", "r": "", "en": "the"}, {"t": "treno", "r": "", "en": "train"}, {"t": "per", "r": "", "en": "for"}, {"t": "Venezia", "r": "", "en": "Venice"}, {"t": "parte", "r": "", "en": "leaves"}, {"t": "dal", "r": "", "en": "from"}, {"t": "binario", "r": "", "en": "platform"}, {"t": "sei", "r": "", "en": "six"}, {"t": "con", "r": "", "en": "with"}, {"t": "venti", "r": "", "en": "twenty"}, {"t": "minuti", "r": "", "en": "minutes"}, {"t": "di", "r": "", "en": "of"}, {"t": "ritardo.", "r": "", "en": "delay"}, {"t": "Compro", "r": "", "en": "I buy"}, {"t": "un", "r": "", "en": "a"}, {"t": "caffè", "r": "", "en": "coffee"}, {"t": "e", "r": "", "en": "and"}, {"t": "aspetto.", "r": "", "en": "I wait"}, {"t": "Arriverò", "r": "", "en": "I'll arrive"}, {"t": "in", "r": "", "en": "in"}, {"t": "albergo", "r": "", "en": "the hotel"}, {"t": "stasera.", "r": "", "en": "tonight"}], "translation": "The train to Venice leaves from platform six, twenty minutes late. I buy a coffee and wait. I'll get to the hotel tonight.", "questions": [{"q": "Where is the train going?", "options": ["Venice", "Rome", "Milan", "Naples"], "answer": "Venice"}, {"q": "Which platform?", "options": ["Six", "Two", "Twenty", "Ten"], "answer": "Six"}, {"q": "How late is the train?", "options": ["Twenty minutes", "One hour", "Five minutes", "On time"], "answer": "Twenty minutes"}]}], "color": "#4fc3a1"}], "ai": false}, {"id": "B1", "jlpt": "CILS UNO", "name": "Intermediate", "desc": "Subjunctive, past narration, conditional, pronouns", "units": [{"title": "Il congiuntivo", "icon": "🌱", "ai": true, "lessons": [{"id": "it-b1-cong-pres", "title": "Present subjunctive", "point": "congiuntivo presente: che io parli, che tu abbia", "type": "grammar", "ai": true, "level": "B1"}, {"id": "it-b1-cong-opinione", "title": "Opinions", "point": "penso che / credo che + congiuntivo", "type": "grammar", "ai": true, "level": "B1"}, {"id": "it-b1-cong-volonta", "title": "Wishes", "point": "voglio che / spero che + congiuntivo", "type": "grammar", "ai": true, "level": "B1"}, {"id": "it-b1-cong-emozione", "title": "Emotions", "point": "sono contento che / mi dispiace che", "type": "grammar", "ai": true, "level": "B1"}], "color": "#ff7aa2"}, {"title": "Raccontare il passato", "icon": "📖", "ai": true, "lessons": [{"id": "it-b1-imperfetto", "title": "When I was little", "point": "imperfetto: ero, avevo, andavo", "type": "grammar", "ai": true, "level": "B1"}, {"id": "it-b1-imp-pp", "title": "Two past tenses", "point": "imperfetto o passato prossimo?", "type": "grammar", "ai": true, "level": "B1"}, {"id": "it-b1-trapassato", "title": "Had done", "point": "trapassato prossimo: avevo già mangiato", "type": "grammar", "ai": true, "level": "B1"}, {"id": "it-b1-connettivi", "title": "Telling a story", "point": "mentre, quando, all'improvviso, alla fine", "type": "grammar", "ai": true, "level": "B1"}], "color": "#7a9cff"}, {"title": "Cortesia e ipotesi", "icon": "🎩", "ai": true, "lessons": [{"id": "it-b1-condizionale", "title": "Would", "point": "condizionale presente: vorrei, potrei, dovrei", "type": "grammar", "ai": true, "level": "B1"}, {"id": "it-b1-consigli", "title": "Advice", "point": "al posto tuo… / dovresti…", "type": "grammar", "ai": true, "level": "B1"}, {"id": "it-b1-pronomi", "title": "Object pronouns", "point": "lo, la, li, le / gli, le", "type": "grammar", "ai": true, "level": "B1"}, {"id": "it-b1-ne-ci", "title": "Ne and ci", "point": "ne prendo due / ci vado domani", "type": "grammar", "ai": true, "level": "B1"}], "color": "#4fc3a1"}, {"title": "Lettura", "icon": "📖", "ai": true, "lessons": [{"id": "it-b1-lettura", "title": "Reading: an email from Turin", "point": "an informal email describing a new job and city", "type": "reading", "ai": true, "level": "B1"}], "color": "#f2a541"}], "ai": true}, {"id": "B2", "jlpt": "CILS DUE", "name": "Upper-intermediate", "desc": "Advanced subjunctive, if clauses, arguing, the passive", "units": [{"title": "Congiuntivo avanzato", "icon": "🧠", "ai": true, "lessons": [{"id": "it-b2-cong-imp", "title": "Imperfect subjunctive", "point": "se avessi tempo… / volevo che tu venissi", "type": "grammar", "ai": true, "level": "B2"}, {"id": "it-b2-periodo-ipotetico", "title": "If clauses", "point": "se + congiuntivo imperfetto + condizionale", "type": "grammar", "ai": true, "level": "B2"}, {"id": "it-b2-concordanza", "title": "Sequence of tenses", "point": "concordanza dei tempi", "type": "grammar", "ai": true, "level": "B2"}, {"id": "it-b2-benche", "title": "Although", "point": "benché / nonostante + congiuntivo", "type": "grammar", "ai": true, "level": "B2"}], "color": "#ff7aa2"}, {"title": "Argomentare", "icon": "🗣️", "ai": true, "lessons": [{"id": "it-b2-opinione", "title": "Arguing a point", "point": "secondo me, a mio avviso, d'altra parte", "type": "grammar", "ai": true, "level": "B2"}, {"id": "it-b2-passivo", "title": "The passive", "point": "essere / venire + participio", "type": "grammar", "ai": true, "level": "B2"}, {"id": "it-b2-si-impersonale", "title": "One does…", "point": "si impersonale e si passivante", "type": "grammar", "ai": true, "level": "B2"}, {"id": "it-b2-gerundio", "title": "Gerund", "point": "stando così le cose / pur essendo", "type": "grammar", "ai": true, "level": "B2"}], "color": "#7a9cff"}, {"title": "Lettura", "icon": "📖", "ai": true, "lessons": [{"id": "it-b2-lettura", "title": "Reading: a newspaper column", "point": "an opinion piece on city life and tourism", "type": "reading", "ai": true, "level": "B2"}], "color": "#4fc3a1"}], "ai": true}, {"id": "C1", "jlpt": "CILS TRE", "name": "Advanced", "desc": "Registers, literary past, formal writing", "units": [{"title": "Stile e registro", "icon": "🖋️", "ai": true, "lessons": [{"id": "it-c1-registri", "title": "Registers", "point": "linguaggio formale, burocratico e colloquiale", "type": "grammar", "ai": true, "level": "C1"}, {"id": "it-c1-passato-remoto", "title": "Literary past", "point": "passato remoto: fu, ebbe, andò", "type": "grammar", "ai": true, "level": "C1"}, {"id": "it-c1-connettivi", "title": "Formal c